# Скопируй в .env (рядом с docker-compose.yml) на сервере и заполни.

# Домен, указывающий A-записью на IP сервера (для авто-HTTPS через Caddy).
DOMAIN=dash.example.com

# Пароль на вход (Basic Auth). Оставь пустыми — доступ без пароля.
DASH_USER=admin
DASH_PASS=смени-меня

# Кэш модели, сек.
CACHE_TTL=45
