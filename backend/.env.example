# Скопируй в .env и подставь свои значения (или задай как переменные окружения).

# Путь к JSON-ключу service-аккаунта (локально). На Cloud Run НЕ нужен —
# там используется привязанный к сервису аккаунт (ADC).
SERVICE_ACCOUNT_FILE=./service-account.json

# Таблица и лист (значения по умолчанию уже верные — можно не задавать).
SPREADSHEET_ID=1oTdRh6ZIDqU4IBoUZghRvGTdsIEBDtASYKD81PwGPrk
SHEET_GID=2080478081

# Кэш модели, сек (опрос фронта — 60 сек).
CACHE_TTL=45

# Защита паролем (Basic Auth). Оставь пустыми — доступ открыт.
DASH_USER=
DASH_PASS=

# Порт (локально по умолчанию 8080; Cloud Run задаёт сам).
PORT=8080
